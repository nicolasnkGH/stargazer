# StarGazer — Environment Variables
# Copy this to .env and fill in your values
#
# 💡 IMPORTANT: No API keys are required! The app works with free public APIs.
#    AI insights are optional — skip the AI section below for rule-based scoring.

# --- Next.js Frontend ---
# URL of the Python/FastAPI backend, used by Next.js API route handlers (server-side).
# For Docker Compose (default): http://stargazer-api:8181
# For local dev: http://localhost:8181 (override in .env)
API_BACKEND=http://stargazer-api:8181

# --- Observer Location ---
OBSERVER_LAT=40.126
OBSERVER_LON=-83.037
OBSERVER_ELEVATION_M=240
OBSERVER_TIMEZONE=America/New_York
# TELESCOPE_APERTURE_MM=130
# TELESCOPE_FOCAL_MM=650

# --- NASA APOD (optional, free at https://api.nasa.gov) ---
# Without this, uses DEMO_KEY (limited to 30 req/hour)
NASA_APOD_KEY=DEMO_KEY

# --- AI Seeing Analysis (OPTIONAL — uncomment and fill in to enable) ---
# Leave ALL of these commented out or empty to use rule-based scoring (free, no keys needed).
# AI_MODEL=gemini-2.5-flash
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# AI_API_KEY=your_api_key
# AI_TIMEOUT=60

# Optional fallback provider (only used if primary AI is configured)
# FALLBACK_AI_API_URL=
# FALLBACK_AI_MODEL=
# FALLBACK_AI_API_KEY=

# --- Cloudflare Access (only needed if your AI endpoint is behind CF Zero Trust) ---
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# --- Push Notifications (optional) ---
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_ADMIN_EMAIL=
