# StarGazer — Environment Variables
# Copy this to .env and fill in your values

# --- Observer Location ---
OBSERVER_LAT=40.126
OBSERVER_LON=-83.037
OBSERVER_ELEVATION_M=240
OBSERVER_TIMEZONE=America/New_York

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# --- NASA APOD (optional, free at https://api.nasa.gov) ---
# Without this, uses DEMO_KEY (limited to 30 req/hour)
NASA_APOD_KEY=DEMO_KEY

# --- API internal URL (used by n8n workflows) ---
# If running on same Docker network as n8n:
STARGAZER_API_URL=http://stargazer-api:8181
# If running on a separate LXC, use its IP:
# STARGAZER_API_URL=http://192.168.1.XXX:8181

# --- AI Seeing Analysis (Qwen3.5-9B on ROCm) ---
# Set these from your runtime secrets/config (Cloud Run env or GitHub Actions secrets)
AI_API_URL=https://YOUR_AI_GATEWAY_FQDN/api/chat/completions
# Example: /models/Qwen3.5-9B-Q5_K_M.gguf
AI_MODEL=YOUR_AI_MODEL_ID
AI_API_KEY=YOUR_AI_API_KEY
CF_ACCESS_CLIENT_ID=YOUR_CF_ACCESS_CLIENT_ID
CF_ACCESS_CLIENT_SECRET=YOUR_CF_ACCESS_CLIENT_SECRET

# Optional fallback provider
FALLBACK_AI_API_URL=
FALLBACK_AI_MODEL=
FALLBACK_AI_API_KEY=
# Seconds before falling back to rule-based scoring (keep low to avoid slow responses)
AI_TIMEOUT=5

